# API Service 环境变量配置

# ==================== 服务器配置 ====================
# 服务器主机地址
HOST=0.0.0.0
# 服务器端口
PORT=8000
# 调试模式 (true/false)
DEBUG=false

# ==================== 上游配置 ====================
# 后端 StackAI 基础地址
BACKEND_API_URL=https://api.stack-ai.com

# ==================== 数据库配置 ====================
# SQLite 数据库文件路径 (相对于项目根目录)
# DATABASE_URL=sqlite+aiosqlite:///./data/api_service.db
# PostgreSQL 示例（DigitalOcean Managed PostgreSQL）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/st_api_dev
# DATABASE_URL=postgresql+asyncpg://st_api_user:YOUR_PASSWORD@db-postgresql-xxx-do-user-xxxx-0.l.db.ondigitalocean.com:25060/defaultdb?ssl=require

# ==================== 安全配置 ====================
# JWT 密钥 (请使用强随机字符串，可通过 openssl rand -hex 32 生成)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
# JWT Token 过期时间 (小时)
JWT_EXPIRE_HOURS=24

# Fernet 加密密钥 (用于加密存储敏感数据，可通过 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成)
ENCRYPTION_KEY=your-fernet-encryption-key-change-this

# ==================== 管理员配置 ====================
# 默认管理员用户名
ADMIN_USERNAME=admin
# 默认管理员密码 (首次启动后请立即修改)
ADMIN_PASSWORD=admin123

# ==================== 登录保护配置 ====================
# 最大登录失败次数
MAX_LOGIN_ATTEMPTS=5
# 登录锁定时间 (分钟)
LOGIN_LOCKOUT_MINUTES=15

# ==================== 日志配置 ====================
# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
# 日志文件路径
LOG_FILE=./data/api_service.log

# ==================== CORS 配置 ====================
# 允许的跨域来源 (逗号分隔，* 表示允许所有)
CORS_ORIGINS=*

# ==================== Worker 代理安全配置（可选） ====================
# Cloudflare Worker 与源站共享密钥。
# 设置后：/v1/* 与 /v1beta/* 请求必须携带正确的 x-proxy-secret 才会放行。
# 建议生成方式: openssl rand -hex 32
PROXY_SHARED_SECRET=

# ==================== 后台隐藏配置 ====================
# 隐藏的管理后台路径 (不设置则每次启动随机生成)
# 访问后台: https://your-domain.com/your-secret-admin-path
# 建议使用随机字符串，如: openssl rand -hex 16
ADMIN_PATH=your-secret-admin-path

# ==================== 高并发配置 ====================
# 数据库连接池大小
DB_POOL_SIZE=20
# 数据库连接池最大溢出
DB_MAX_OVERFLOW=30
# 数据库连接超时 (秒)
DB_POOL_TIMEOUT=30
# 数据库连接回收时间 (秒)
DB_POOL_RECYCLE=3600

# PostgreSQL 连接参数（可选，不设置则使用驱动默认值）
# 建连超时（秒）
POSTGRES_CONNECT_TIMEOUT_SECONDS=
# 单条 SQL 命令超时（秒）
POSTGRES_COMMAND_TIMEOUT_SECONDS=
# PostgreSQL statement_timeout（毫秒）
POSTGRES_STATEMENT_TIMEOUT_MS=
# PostgreSQL lock_timeout（毫秒）
POSTGRES_LOCK_TIMEOUT_MS=
# PostgreSQL application_name
POSTGRES_APPLICATION_NAME=st-api

# PostgreSQL 连接预算提示（可选，仅用于启动日志告警）
# 托管数据库连接上限，例如 DO Starter 常见为 47
DB_CONNECTION_LIMIT=
# 预留连接数（给管理、备份、临时排障）
DB_CONNECTION_RESERVE=6
# 应用实例数（单机=1，多副本时按实际填写）
APP_INSTANCE_COUNT=1

# HTTP 客户端最大连接数
HTTP_MAX_CONNECTIONS=100
# HTTP 客户端每主机最大连接数（并发服务限流使用）
HTTP_MAX_CONNECTIONS_PER_HOST=20
# HTTP 客户端最大保持连接数
HTTP_MAX_KEEPALIVE=20
# HTTP 请求超时 (秒)
HTTP_TIMEOUT=60.0
# HTTP 连接超时 (秒)
HTTP_CONNECT_TIMEOUT=10.0
# 是否信任系统代理环境变量（建议本地压测关闭）
HTTP_TRUST_ENV=false

# 上游同步请求超时（秒）
BACKEND_TIMEOUT_SECONDS=120.0
# 上游流式读取超时（秒）
BACKEND_STREAM_TIMEOUT_SECONDS=300.0
# 上游同步请求重试次数（不含首次）
BACKEND_SYNC_MAX_RETRIES=2
# 上游流式请求重试次数（仅在未输出内容前生效，不含首次）
BACKEND_STREAM_MAX_RETRIES=1
# 连接错误是否重试（建议开启）
BACKEND_RETRY_ON_CONNECT_ERROR=true
# 超时错误是否重试（建议关闭，避免重复计费放大）
BACKEND_RETRY_ON_TIMEOUT=false
# 其它传输错误是否重试
BACKEND_RETRY_ON_TRANSPORT_ERROR=true
# 重试基准退避时间（秒）
BACKEND_RETRY_BASE_DELAY_SECONDS=0.25
# 重试最大退避时间（秒）
BACKEND_RETRY_MAX_DELAY_SECONDS=2.0
# 重试随机抖动上限（秒）
BACKEND_RETRY_JITTER_SECONDS=0.10
# 可重试的 HTTP 状态码（逗号分隔）
BACKEND_RETRY_STATUS_CODES=429,500,502,503,504

# 最大并发请求数
MAX_CONCURRENT_REQUESTS=100
# 最大并发数据库操作数
MAX_CONCURRENT_DB_OPS=50
# 单模型组最大并发
MAX_CONCURRENT_PER_MODEL_GROUP=20
# 请求排队超时（秒）
QUEUE_TIMEOUT_SECONDS=30
# 请求排队超时（新变量，优先于 QUEUE_TIMEOUT_SECONDS）
REQUEST_QUEUE_TIMEOUT_SECONDS=30
# 令牌桶限流（每秒）
RATE_LIMIT_PER_SECOND=100
# 令牌桶突发容量
RATE_LIMIT_BURST=200

# ==================== PostgreSQL(47连接)参考配置 ====================
# 下列是“2c/4g 网关 + PostgreSQL 47 connections”推荐起步值
# UVICORN_WORKERS=2
# MAX_CONCURRENT_REQUESTS=60
# MAX_CONCURRENT_DB_OPS=30
# REQUEST_QUEUE_TIMEOUT_SECONDS=8
# HTTP_MAX_CONNECTIONS=160
# HTTP_MAX_CONNECTIONS_PER_HOST=40
# HTTP_MAX_KEEPALIVE=40
# DB_POOL_SIZE=8
# DB_MAX_OVERFLOW=2
# DB_POOL_TIMEOUT=5
# DB_POOL_RECYCLE=1800
# DB_CONNECTION_LIMIT=47

# ==================== 调用日志清理 ====================
# 详细调用日志最大保留条数
MAX_CALL_LOG_ENTRIES=100
# 是否启用自动清理
CALL_LOG_AUTO_CLEANUP=true
# 每累计多少次写入触发一次清理检查
CALL_LOG_CLEANUP_EVERY_N_WRITES=200
# 两次清理最小时间间隔（秒）
CALL_LOG_CLEANUP_MIN_INTERVAL_SECONDS=30

# ==================== 持久化降载开关 ====================
# 是否持久化 request_logs
ENABLE_REQUEST_LOG_PERSIST=true
# 是否持久化 call_logs
ENABLE_CALL_LOG_PERSIST=true
# call_logs 持久化采样率（0.0~1.0）
CALL_LOG_SAMPLE_RATE=1.0
# 是否持久化 system_stats
ENABLE_SYSTEM_STATS_PERSIST=true





# ==================== Tool Use 配置 ====================
# 是否启用 Tool Use 功能 (true/false)
# 启用后支持 Claude Code 等工具的文件操作功能
ENABLE_TOOL_USE=true

# 启用的工具列表 (逗号分隔)
# 可用工具: Read, Write, Edit, Bash, Grep, Glob, Diff, LS
# 留空或不设置则启用所有默认工具
# 示例: ENABLED_TOOLS=Read,Write,Edit,Bash
ENABLED_TOOLS=Read,Write,Edit,Bash,Grep,Glob,Diff,LS
