# API Service 环境变量配置

# ==================== 服务器配置 ====================
# 服务器主机地址
HOST=0.0.0.0
# 服务器端口
PORT=8000
# 调试模式 (true/false)
DEBUG=false

# ==================== 数据库配置 ====================
# SQLite 数据库文件路径 (相对于项目根目录)
DATABASE_URL=sqlite+aiosqlite:///./data/api_service.db

# ==================== 安全配置 ====================
# JWT 密钥 (请使用强随机字符串，可通过 openssl rand -hex 32 生成)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
# JWT Token 过期时间 (小时)
JWT_EXPIRE_HOURS=24

# Fernet 加密密钥 (用于加密存储敏感数据，可通过 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成)
ENCRYPTION_KEY=your-fernet-encryption-key-change-this

# ==================== 管理员配置 ====================
# 默认管理员用户名
ADMIN_USERNAME=admin
# 默认管理员密码 (首次启动后请立即修改)
ADMIN_PASSWORD=admin123

# ==================== 登录保护配置 ====================
# 最大登录失败次数
MAX_LOGIN_ATTEMPTS=5
# 登录锁定时间 (分钟)
LOGIN_LOCKOUT_MINUTES=15

# ==================== 日志配置 ====================
# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
# 日志文件路径
LOG_FILE=./data/api_service.log

# ==================== CORS 配置 ====================
# 允许的跨域来源 (逗号分隔，* 表示允许所有)
CORS_ORIGINS=*

# ==================== 后台隐藏配置 ====================
# 隐藏的管理后台路径 (不设置则每次启动随机生成)
# 访问后台: https://your-domain.com/your-secret-admin-path
# 建议使用随机字符串，如: openssl rand -hex 16
ADMIN_PATH=your-secret-admin-path
