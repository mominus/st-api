# st-api 环境变量示例
#
# 使用顺序：
# 1. 先填写“最小必填”
# 2. 线上使用 PostgreSQL 时，直接沿用“PostgreSQL / 47 连接起步值”
# 3. 压测时优先关注：
#    MAX_CONCURRENT_REQUESTS / MAX_CONCURRENT_STREAMS / MAX_CONCURRENT_DB_OPS
#    HTTP_MAX_CONNECTIONS* / DB_POOL_* / REQUEST_QUEUE_TIMEOUT_SECONDS
#    ACCOUNT_MAX_INFLIGHT_REQUESTS_PER_ACCOUNT
# 4. 最底部“兼容旧变量”仅用于兼容旧部署，新部署不要再设置
#
# 说明：
# - 本文件里的显式数值以“生产起步值”为主，不一定等于代码内置默认值。
# - 如果只是本地快速跑通，可把 DATABASE_URL 改成下方 SQLite 示例。

# ==================== 最小必填 ====================
# 监听地址
HOST=0.0.0.0
# 监听端口
PORT=8000
# 调试模式（true/false）
DEBUG=false

# 上游基础地址
BACKEND_API_URL=https://api.stack-ai.com

# 数据库连接串
# SQLite 示例：
# DATABASE_URL=sqlite+aiosqlite:///./data/api_service.db
# PostgreSQL 示例：
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/st_api
# DigitalOcean Managed PostgreSQL 示例：
# DATABASE_URL=postgresql+asyncpg://st_api_user:YOUR_PASSWORD@db-postgresql-xxx-do-user-xxxx-0.l.db.ondigitalocean.com:25060/defaultdb?ssl=require

# JWT 密钥，务必替换
JWT_SECRET_KEY=replace-with-a-random-jwt-secret
# Fernet 加密密钥，务必替换
ENCRYPTION_KEY=replace-with-a-random-fernet-key

# 初始管理员账号，首次启动后建议立即修改
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# ==================== 生产常用 ====================
# 生产建议 >= 2；DEBUG=true 时仍会走单 worker 模式
UVICORN_WORKERS=2
# 短连接/重连较多时可适当调大
UVICORN_BACKLOG=2048
# keep-alive 超时（秒）
UVICORN_TIMEOUT_KEEP_ALIVE=10

# JWT 过期时间（小时）
JWT_EXPIRE_HOURS=24

# 隐藏后台路径；留空则每次启动随机生成
ADMIN_PATH=your-secret-admin-path

# Cloudflare Worker 与源站共享密钥；不使用 Worker 可留空
PROXY_SHARED_SECRET=

# 登录保护
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# 基础日志
LOG_LEVEL=INFO
LOG_FILE=./data/api_service.log

# CORS；生产环境建议改成明确域名列表
CORS_ORIGINS=*

# 当前仅用于管理后台展示/写回，0 表示无限制
RPM_LIMIT=0

# ==================== PostgreSQL / 47 连接起步值 ====================
# 这一组是“单实例 + Uvicorn workers=2 + 托管 PostgreSQL 47 连接”推荐起步值
# 如果你部署多个实例，请同步调整 APP_INSTANCE_COUNT，并重新评估 DB 池预算
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE=1800

# PostgreSQL 连接预算提示（用于启动告警与预算检查）
DB_CONNECTION_LIMIT=47
DB_CONNECTION_RESERVE=6
APP_INSTANCE_COUNT=1

# PostgreSQL 驱动/会话参数
POSTGRES_CONNECT_TIMEOUT_SECONDS=8
POSTGRES_COMMAND_TIMEOUT_SECONDS=30
POSTGRES_STATEMENT_TIMEOUT_MS=30000
POSTGRES_LOCK_TIMEOUT_MS=5000
POSTGRES_APPLICATION_NAME=st-api

# ==================== 入口并发 / 排队 ====================
# 请求入口并发上限
MAX_CONCURRENT_REQUESTS=60
# 流式响应并发上限（SSE 生命周期内占用独立 stream 槽位）
MAX_CONCURRENT_STREAMS=40
# 请求排队等待超时（秒）
REQUEST_QUEUE_TIMEOUT_SECONDS=8

# 流式响应是否在整个 SSE 生命周期内占用 stream 槽位
HOLD_STREAM_REQUEST_SLOT_UNTIL_FINISH=true
# 获取 stream 槽位的等待超时；建议明显短于 REQUEST_QUEUE_TIMEOUT_SECONDS
STREAM_QUEUE_TIMEOUT_SECONDS=2

# DB 操作并发闸门；建议不要高于 DB_POOL_SIZE + DB_MAX_OVERFLOW
MAX_CONCURRENT_DB_OPS=10
ENABLE_DB_OP_LIMITER=true
DB_OP_ACQUIRE_TIMEOUT_SECONDS=8.0

# 单模型组最大并发
MAX_CONCURRENT_PER_MODEL_GROUP=20

# 热路径缓存 TTL（秒），减少重复读取 model_groups
MODEL_INPUT_MAPPING_CACHE_TTL_SECONDS=60

# 令牌桶限流
RATE_LIMIT_PER_SECOND=100
RATE_LIMIT_BURST=200

# ==================== 上游 HTTP 池 / 超时 ====================
# tool-heavy 场景优先看这一组
HTTP_MAX_CONNECTIONS=160
# 当主链路只连一个 BACKEND_API_URL 时，这个值基本就是该上游的有效并发连接上限
HTTP_MAX_CONNECTIONS_PER_HOST=40
HTTP_MAX_KEEPALIVE=40

# HTTP 连接池取连接等待超时（秒）
HTTP_POOL_TIMEOUT_SECONDS=8.0
# 留空时：默认比总出站连接少 1，给短同步请求保留通道
# 设为 0 表示关闭这层 stream 专属保护，仅受总出站连接数限制
BACKEND_MAX_CONCURRENT_STREAMS=
HTTP_KEEPALIVE_EXPIRY_SECONDS=15.0
HTTP_TIMEOUT=60.0
HTTP_CONNECT_TIMEOUT=10.0
# 本地压测通常建议 false，避免意外挂到系统代理
HTTP_TRUST_ENV=false

# 上游同步/流式超时
BACKEND_TIMEOUT_SECONDS=120.0
BACKEND_STREAM_TIMEOUT_SECONDS=300.0

# ==================== 上游重试 / 换号 / 账号保护 ====================
# 上游基础重试
BACKEND_SYNC_MAX_RETRIES=2
BACKEND_STREAM_MAX_RETRIES=2
BACKEND_RETRY_ON_CONNECT_ERROR=true
BACKEND_RETRY_ON_TIMEOUT=true
BACKEND_RETRY_ON_TRANSPORT_ERROR=true
BACKEND_RETRY_BASE_DELAY_SECONDS=0.25
BACKEND_RETRY_MAX_DELAY_SECONDS=2.0
BACKEND_RETRY_JITTER_SECONDS=0.10
BACKEND_RETRY_STATUS_CODES=429,500,502,503,504

# 网关级换账号重试
ENABLE_ACCOUNT_FAILOVER_RETRY=true
# 402 会被视为上游账号额度耗尽并触发换号
ACCOUNT_FAILOVER_RETRY_STATUS_CODES=402,429,500,502,503,504
# 包含首次在内的总尝试次数约等于 1 + failover 次数；这里表示最多再换 1 个账号
ACCOUNT_FAILOVER_MAX_ATTEMPTS=2

# 账号选择短退避；用于降低并发瞬时“无可用账号”误判
ACCOUNT_SELECT_MAX_RETRIES=1
ACCOUNT_SELECT_RETRY_DELAY_SECONDS=0.08
ACCOUNT_SELECT_RETRY_JITTER_SECONDS=0.02

# 单账号飞行中请求保护；tool use 较多时建议开启
ACCOUNT_MAX_INFLIGHT_REQUESTS_PER_ACCOUNT=8
# 飞行中请求租约 TTL（秒）；进程异常退出后可自动清理旧占位
ACCOUNT_INFLIGHT_LEASE_SECONDS=900

# 暂时性错误时对当前账号做短暂冷却
AUTO_COOLDOWN_ON_TRANSIENT_ERRORS=true
ACCOUNT_TRANSIENT_ERROR_COOLDOWN_SECONDS=20

# 权限错误是否自动禁用账号；默认关闭，避免误伤短暂抖动
AUTO_DISABLE_ON_PERMISSION_DENIED=false

# ==================== 异步落库 / 日志降载 ====================
# 非关键日志（request_logs / call_logs）异步后台落库
ASYNC_NONCRITICAL_LOG_PERSIST=true
# 后台日志 worker 建议保持很小，避免与主链路争抢 DB/CPU
BACKGROUND_LOG_WORKERS=2
# 队列满时直接丢弃低价值日志，不阻塞主链路
BACKGROUND_LOG_QUEUE_MAX_SIZE=5000

# 使用量聚合异步批量落库
ENABLE_ASYNC_USAGE_AGGREGATION=true
ASYNC_USAGE_QUEUE_MAX_SIZE=20000
ASYNC_USAGE_MAX_BATCH_SIZE=300
ASYNC_USAGE_FLUSH_INTERVAL_SECONDS=0.5
ASYNC_USAGE_WORKERS=2
ASYNC_USAGE_DB_ACQUIRE_TIMEOUT_SECONDS=8.0
ASYNC_USAGE_MAX_RETRIES=3

# 持久化开关
ENABLE_REQUEST_LOG_PERSIST=true
ENABLE_CALL_LOG_PERSIST=true
ENABLE_SYSTEM_STATS_PERSIST=true

# call_logs 采样率（0.0 ~ 1.0）
CALL_LOG_SAMPLE_RATE=1.0

# 详细调用日志清理
MAX_CALL_LOG_ENTRIES=5000
CALL_LOG_AUTO_CLEANUP=true
CALL_LOG_CLEANUP_EVERY_N_WRITES=1000
CALL_LOG_CLEANUP_MIN_INTERVAL_SECONDS=120

# ==================== Tool Use ====================
# 启用后支持 Claude Code 等工具调用
ENABLE_TOOL_USE=true
# 留空 = 使用内置默认工具集合（Read,Write,Edit,Bash,Grep,Glob,Diff,LS）
ENABLED_TOOLS=

# ==================== SQLite 专用（仅 SQLite 时考虑） ====================
# 默认会复用 DB_POOL_*；只有 SQLite 需要单独覆盖时再设置
# SQLITE_POOL_SIZE=8
# SQLITE_MAX_OVERFLOW=2
# SQLITE_POOL_TIMEOUT=5
# SQLITE_POOL_RECYCLE=1800

# ==================== 兼容旧变量（新部署不要再设置） ====================
# 旧版请求排队超时；新变量 REQUEST_QUEUE_TIMEOUT_SECONDS 优先
# QUEUE_TIMEOUT_SECONDS=8

# 旧版流式非关键日志异步落库开关；新变量 ASYNC_NONCRITICAL_LOG_PERSIST 优先
# ASYNC_STREAM_NONCRITICAL_LOG_PERSIST=true

# 旧版后台日志 worker 变量；新变量 BACKGROUND_LOG_WORKERS 优先
# BACKGROUND_LOG_MAX_CONCURRENCY=2
